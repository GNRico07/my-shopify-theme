<div class="fz-cd">
  <div class="fz-cd-inner">
    <div class="fz-cd-icon">🎨</div>
    <div class="fz-cd-eyebrow">Custom Orders</div>
    <h2 class="fz-cd-title">Have a Design in Mind? <span>We'll Make It Happen.</span></h2>
    <p class="fz-cd-desc">Feel free to send us your design — a logo, a joke, an idea, anything — and we'll put it on a shirt for you. Custom tees for anyone, any occasion.</p>
    <a href="mailto:510ricogn@gmail.com?subject=Custom Design Request" class="fz-cd-btn">📧 Send Us Your Design</a>
    <p class="fz-cd-note">Email us at <strong>510ricogn@gmail.com</strong> and we'll take it from there.</p>
  </div>
</div>

{% stylesheet %}
.fz-cd{padding:64px 24px;background:#141416;border-top:1px solid rgba(255,107,53,.12);border-bottom:1px solid rgba(255,107,53,.12);text-align:center;position:relative;overflow:hidden;}
.fz-cd::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 50% 50%,rgba(255,107,53,.06) 0%,transparent 70%);pointer-events:none;}
.fz-cd-inner{max-width:640px;margin:0 auto;position:relative;z-index:1;}
.fz-cd-icon{font-size:2.6rem;margin-bottom:10px;}
.fz-cd-eyebrow{display:inline-block;background:rgba(255,107,53,.12);border:1px solid rgba(255,107,53,.4);color:#FF8C5A;padding:5px 16px;border-radius:30px;font-weight:800;font-size:.72rem;letter-spacing:1.5px;text-transform:uppercase;font-family:'Nunito',sans-serif;margin-bottom:16px;}
.fz-cd-title{font-family:'Fredoka',sans-serif!important;font-size:2.2rem;color:#F5F0E8!important;margin-bottom:12px;line-height:1.2;}
.fz-cd-title span{color:#FF6B35!important;}
.fz-cd-desc{font-family:'Nunito',sans-serif;font-size:1rem;color:#A8A09A;line-height:1.75;margin-bottom:28px;}
.fz-cd-btn{display:inline-block;background:#FF6B35;color:#fff;padding:15px 38px;border-radius:40px;font-weight:800;font-size:1rem;text-decoration:none;font-family:'Nunito',sans-serif;box-shadow:0 8px 24px rgba(255,107,53,.3);transition:background .2s,transform .2s;margin-bottom:16px;}
.fz-cd-btn:hover{background:#FF8C5A;transform:translateY(-3px);color:#fff;}
.fz-cd-note{font-family:'Nunito',sans-serif;font-size:.85rem;color:#6B6560;}
.fz-cd-note strong{color:#FF8C5A;}
{% endstylesheet %}

{% schema %}
{"name":"Custom Design Callout","settings":[]}
{% endschema %}
