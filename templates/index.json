          "type": "text",
          "settings": {
            "text": "<h2>Why Funny Shirtz?</h2><p>Because life's too short for boring clothes. We print bold, funny, conversation-starting tees on premium soft cotton \u2014 shipped fast, designed to make people actually laugh out loud.</p>",
            "type_preset": "rte"
          }
